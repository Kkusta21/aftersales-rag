# Optional. Without a key the assistant uses the extractive fallback (no LLM).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# "hashing" runs offline. "sentence-transformers" needs `pip install -e ".[semantic]"`.
EMBEDDER=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# e.g. cross-encoder/ms-marco-MiniLM-L-6-v2 (needs the semantic extra)
RERANKER_MODEL=

RETRIEVAL_MODE=hybrid
TOP_K=4
MIN_RELEVANCE=0.25
